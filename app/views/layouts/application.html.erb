<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DCCastillo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <% flash.each do |name, msg| %>
      <div style="color: <%= name == 'notice' ? 'green' : 'red' %>; text-align: center; padding: 10px; font-weight: bold;">
        <%= msg %>
      </div>
    <% end %>

    <%= yield %>

  </body>
</html>