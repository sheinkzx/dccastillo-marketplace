<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DCCastillo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0; padding: 0; font-family: sans-serif;">

    <%# MENÚ GLOBAL PARA USUARIOS CONECTADOS %>
    <% if current_user %>
      <div style="background-color: #f8f9fa; padding: 15px 30px; border-bottom: 1px solid #ddd; display: flex; justify-content: flex-end; gap: 20px; align-items: center;">
        <span style="color: #666; font-size: 0.9em; margin-right: auto;">👋 Hola, <strong><%= current_user.nombre %></strong></span>
        
        <%= link_to "🏠 Inicio", root_path, style: "text-decoration: none; color: #333; font-weight: bold;" %>
        
        <%# AQUÍ ESTÁ EL BOTÓN DE LA BANDEJA DE ENTRADA %>
        <%= link_to "✉️ Mis Mensajes", conversations_path, style: "text-decoration: none; color: #2e83ff; font-weight: bold;" %>
        
        <%= button_to "Cerrar Sesión", logout_path, method: :delete, style: "background: none; border: none; color: #e74c3c; cursor: pointer; font-weight: bold; font-size: 1em;" %>
      </div>
    <% end %>

    <%# MENSAJES DE ALERTA O ÉXITO %>
    <% flash.each do |name, msg| %>
      <div style="background-color: <%= name == 'notice' ? '#d1fae5' : '#fee2e2' %>; color: <%= name == 'notice' ? '#065f46' : '#991b1b' %>; text-align: center; padding: 10px; font-weight: bold;">
        <%= msg %>
      </div>
    <% end %>

    <%# AQUÍ SE CARGA EL RESTO DE LAS PÁGINAS %>
    <div style="padding: 20px;">
      <%= yield %>
    </div>

  </body>
</html>