<h1>Editando a: <%= @usuario.nombre %></h1>

<%= form_with model: @usuario, url: admin_actualizar_usuario_path(@usuario), method: :patch, local: true do |f| %>
  <div>
    <%= f.label :nombre, "Nombre" %><br>
    <%= f.text_field :nombre %>
  </div>
  <div>
    <%= f.label :email, "Correo electrónico" %><br>
    <%= f.email_field :email %>
  </div>
  <div>
    <%= f.label :url_foto, "URL de foto de perfil" %><br>
    <%= f.url_field :url_foto, placeholder: "https://..." %>
    <br>
    <% foto = @usuario.url_foto.present? ? @usuario.url_foto
         : "https://ui-avatars.com/api/?name=#{URI.encode_www_form_component(@usuario.nombre)}&background=2c3e50&color=fff&size=100&rounded=true" %>
    <img src="<%= foto %>" style="width:100px;height:100px;border-radius:50%;object-fit:cover;margin-top:8px;">
  </div>
  <div>
    <%= f.label :password, "Cambiar Contraseña (dejar vacío para no cambiar)" %><br>
    <%= f.password_field :password, autocomplete: "new-password" %>
    <small>Si ingresas una clave, la anterior quedará invalidada.</small>
  </div>
  <%= f.submit "Guardar cambios" %>
<% end %>

<%= link_to "← Volver al panel", admin_usuarios_path %>