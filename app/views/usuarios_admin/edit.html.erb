<div class="container">
  <h1><%= t("admin.editar_usuario.titulo", nombre: @usuario.nombre) %></h1>

  <% foto = @usuario.url_foto.present? ? @usuario.url_foto
       : "https://ui-avatars.com/api/?name=#{URI.encode_www_form_component(@usuario.nombre)}&background=2c3e50&color=fff&size=100&rounded=true" %>
  <img src="<%= foto %>" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin: 0 auto 20px; display: block;">

  <%= form_with model: @usuario, url: admin_actualizar_usuario_path(@usuario), method: :patch, local: true do |f| %>
    <div class="formulario-grid-2x4">

      <div class="form-group">
        <%= f.label :nombre, t("admin.editar_usuario.nombre") %>
        <%= f.text_field :nombre %>
      </div>

      <div class="form-group">
        <%= f.label :email, t("admin.editar_usuario.email") %>
        <%= f.email_field :email %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :url_foto, t("admin.editar_usuario.url_foto") %>
        <%= f.url_field :url_foto, placeholder: "https://..." %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :password, t("admin.editar_usuario.password") %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <small><%= t("admin.editar_usuario.password_aviso") %></small>
      </div>

      <div class="grid-full">
        <%= f.submit t("admin.editar_usuario.guardar"), class: "btn" %>
        <%= link_to t("admin.editar_usuario.volver"), admin_usuarios_path, class: "btn btn-secondary" %>
      </div>

    </div>
  <% end %>
</div>