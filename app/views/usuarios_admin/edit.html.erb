<div class="container">
  <h1>Editando a: <%= @usuario.nombre %></h1>

  <% foto = @usuario.url_foto.present? ? @usuario.url_foto
       : "https://ui-avatars.com/api/?name=#{URI.encode_www_form_component(@usuario.nombre)}&background=2c3e50&color=fff&size=100&rounded=true" %>
  <img src="<%= foto %>" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin: 0 auto 20px; display: block;">

  <%= form_with model: @usuario, url: admin_actualizar_usuario_path(@usuario), method: :patch, local: true do |f| %>
    <div class="formulario-grid-2x4">

      <div class="form-group">
        <%= f.label :nombre, "Nombre" %>
        <%= f.text_field :nombre %>
      </div>

      <div class="form-group">
        <%= f.label :email, "Correo electrónico" %>
        <%= f.email_field :email %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :url_foto, "URL de foto de perfil" %>
        <%= f.url_field :url_foto, placeholder: "https://..." %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :password, "Cambiar Contraseña (dejar vacío para no cambiar)" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <small>Si ingresas una clave, la anterior quedará invalidada.</small>
      </div>

      <div class="grid-full">
        <%= f.submit "Guardar cambios", class: "btn" %>
        <%= link_to "← Volver al panel", admin_usuarios_path, class: "btn btn-secondary" %>
      </div>

    </div>
  <% end %>
</div>