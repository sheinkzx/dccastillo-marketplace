<div class="container">

  <h1><%= t("sesion.titulo") %></h1>

  <%= form_with url: login_path, local: true, class: "formulario" do |f| %>

    <label><%= t("sesion.email") %></label>
    <%= f.email_field :email %>

    <label><%= t("sesion.contrasena") %></label>
    <%= f.password_field :password %>

    <%= f.submit t("sesion.entrar"), class: "btn" %>
  <% end %>

  <% if flash[:alert] %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>
  
</div>