<div class="container">
  <h1>Iniciar Sesión</h1>

  <%= form_with url: login_path, local: true, class: "formulario" do |f| %>

    <label>Email</label>
    <%= f.email_field :email %>

    <label>Contraseña</label>
    <%= f.password_field :password %>

    <%= f.submit "Entrar", class: "btn" %>

  <% end %>

  <% if flash[:alert] %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>
</div>