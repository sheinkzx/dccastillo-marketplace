


<h1>Iniciar Sesión</h1>

<%= form_with url: login_path, local: true do |f| %>
  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "Contraseña" %><br>
    <%= f.password_field :password %>
  </div>

  <%= f.submit "Entrar" %>
<% end %>