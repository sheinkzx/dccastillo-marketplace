<div class="container">
  <h1><%= t("home.titulo") %></h1>

  <% if session[:user_id] %>
    <% user = User.find_by(id: session[:user_id]) %>

    <div class="info-box">
      <h2><%= t("home.hola", nombre: user.nombre) %></h2>
      <p><%= t("home.ingresado_como") %> <strong><%= user.type %></strong></p>
      <% foto_url = user.url_foto.present? ? user.url_foto : "https://ui-avatars.com/api/?name=#{URI.encode_www_form_component(user.nombre)}&background=2c3e50&color=fff&size=100&rounded=true" %>
      <img src="<%= foto_url %>" alt="<%= t("navbar.foto_perfil") %>" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin: 10px auto; display: block;">
      <div class="menu" style="margin-top: 15px;">
        <%= link_to t("home.editar_perfil"), editar_perfil_path, class: "btn" %>
        <%= button_to t("home.cerrar_sesion"), logout_path, method: :delete,
            class: "btn btn-secondary",
            form: { style: "display:block; width:100%;" } %>
      </div>
    </div>

    <% if current_user&.is_a?(Vendedor) %>
      <div class="info-box" style="margin-top: 20px;">
        <h2><%= t("home.vendedor.mis_productos") %></h2>
        <%= link_to t("home.vendedor.publicar_producto"), "/productos/new", class: "btn" %>
        <% if @productos.any? %>
          <table class="tabla-estandar">
            <thead>
              <tr>
                <th><%= t("home.vendedor.tabla.producto") %></th>
                <th><%= t("home.vendedor.tabla.precio") %></th>
                <th><%= t("home.vendedor.tabla.stock") %></th>
                <th><%= t("home.vendedor.tabla.estado") %></th>
                <th><%= t("home.vendedor.tabla.acciones") %></th>
              </tr>
            </thead>
            <tbody>
              <% @productos.each do |producto| %>
                <tr>
                  <td>
                    <a href="/productos/<%= producto.id %>"><%= producto.titulo %></a>
                    <% vendedor = producto.respond_to?(:vendedor) ? producto.vendedor : producto.user %>
                    <% if vendedor %>
                      <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                        <% if vendedor.url_foto.present? %>
                          <img src="<%= vendedor.url_foto %>" alt="Foto" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
                        <% else %>
                          <div style="width: 28px; height: 28px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; font-size: 14px;">👤</div>
                        <% end %>
                        <small><%= link_to vendedor.nombre, perfil_publico_path(vendedor) %></small>
                      </div>
                    <% end %>
                  </td>
                  <td>$<%= producto.precio %></td>
                  <td><%= producto.stock %></td>
                  <td><strong><%= producto.estado %></strong></td>
                  <td style="display:flex; gap:8px;">
                    <%= link_to t("home.vendedor.editar"), "/productos/#{producto.id}/edit", class: "btn" %>
                    <%= button_to "🗑️", "/productos/#{producto.id}", method: :delete,
                        data: { turbo_confirm: t("home.vendedor.confirmar_eliminar") },
                        class: "btn btn-secondary" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p><%= t("home.vendedor.sin_productos") %></p>
        <% end %>
      </div>

      <div class="info-box" style="margin-top: 20px;">
        <h2><%= t("home.vendedor.solicitudes_pendientes") %></h2>
        <% if @compras_pendientes.any? %>
          <table class="tabla-estandar">
            <thead>
              <tr>
                <th><%= t("home.vendedor.tabla_compras.producto") %></th>
                <th><%= t("home.vendedor.tabla_compras.cliente") %></th>
                <th><%= t("home.vendedor.tabla_compras.fecha") %></th>
                <th><%= t("home.vendedor.tabla_compras.estado") %></th>
                <th><%= t("home.vendedor.tabla_compras.accion") %></th>
              </tr>
            </thead>
            <tbody>
              <% @compras_pendientes.each do |compra| %>
                <tr>
                  <td><strong><%= compra.producto.titulo %></strong></td>
                  <td><%= compra.cliente.nombre %></td>
                  <td><%= compra.fecha %></td>
                  <td><%= compra.estado %></td>
                  <td>
                    <%= button_to t("home.vendedor.aprobar"), "/compras/#{compra.id}", method: :patch, class: "btn" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p><%= t("home.vendedor.sin_solicitudes") %></p>
        <% end %>
      </div>
    <% end %>

    <% if current_user&.is_a?(Cliente) %>
      <div class="info-box" style="margin-top: 20px;">
        <h2><%= t("home.cliente.mis_compras") %></h2>
        <% if @compras.any? %>
          <table class="tabla-estandar">
            <thead>
              <tr>
                <th><%= t("home.cliente.tabla.producto") %></th>
                <th><%= t("home.cliente.tabla.fecha") %></th>
                <th><%= t("home.cliente.tabla.estado") %></th>
              </tr>
            </thead>
            <tbody>
              <% @compras.each do |compra| %>
                <tr>
                  <td><strong><%= compra.producto.titulo %></strong></td>
                  <td><%= compra.fecha %></td>
                  <td><%= compra.estado.capitalize %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p><%= t("home.cliente.sin_compras") %></p>
        <% end %>
      </div>

      <div class="info-box" style="margin-top: 20px;">
        <h2><%= t("home.cliente.panel_titulo") %></h2>
        <div class="menu" style="margin-top: 10px;">
          <%= link_to t("home.cliente.ver_catalogo"), productos_path, class: "btn" %>
          <%= link_to t("home.cliente.ver_favoritos"), "/mis_favoritos", class: "btn btn-secondary" %>
        </div>
      </div>
    <% end %>

    <% if current_user&.is_a?(Administrador) %>
      <div class="info-box" style="margin-top: 20px;">
        <h2><%= t("home.administrador.panel_titulo") %></h2>
        <%= link_to t("home.administrador.ver_usuarios"), admin_usuarios_path, class: "btn" %>
      </div>
    <% end %>

  <% else %>
    <p><%= t("home.que_deseas") %></p>
    <div class="menu">
      <%= link_to t("home.iniciar_sesion"), login_path, class: "btn" %>
      <%= link_to t("home.registrarse"), signup_path, class: "btn btn-secondary" %>
    </div>
    <div style="text-align: center;">
      <%= image_tag "image.png", alt: "POCHITA", style: "width: 150px; margin-top: 20px;" %>
    </div>
  <% end %>
</div>