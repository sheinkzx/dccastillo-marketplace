<div class="container">

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <%= link_to "← Volver a usuarios", admin_usuarios_path, class: "btn",
          style: "width: fit-content;" %>
      <h1 style="margin-top: 10px;">Control de reseñas</h1>
      <p>Comentarios reportados pendientes de revisión</p>
    </div>
    <span style="background-color: #dc3545; color: white; font-weight: bold;
                 padding: 6px 14px; border-radius: 999px; font-size: 0.9rem;">
      <%= @reportes.size %> pendientes
    </span>
  </div>

  <% if @reportes.empty? %>
    <p class="success">✓ No hay reportes pendientes.</p>
  <% else %>
    <% @reportes.each do |reporte| %>
      <% review = reporte.producto_review %>
      <% autor  = review.user %>

      <div class="info-box" style="margin-top: 20px;">

        <div style="display: flex; justify-content: space-between; align-items: center;">
          <h2 style="color: #b45309;">⚑ <%= reporte.motivo %></h2>
          <small><%= reporte.created_at.strftime("%-d %b %Y, %H:%M") %></small>
        </div>

        <blockquote style="border-left: 4px solid #ccc; margin: 10px 0; padding: 10px 15px;
                           background: #f8f9fa; border-radius: 4px; font-style: italic;">
          "<%= review.txt %>"
          <% if review.respond_to?(:puntaje) %>
            <div style="margin-top: 6px;">
              <% review.puntaje.times do %><span class="estrella-llena">★</span><% end %>
              <% (5 - review.puntaje).times do %><span class="estrella-vacia">★</span><% end %>
            </div>
          <% end %>
        </blockquote>

        <% if reporte.detalle.present? %>
          <p style="background: #fffbeb; padding: 8px 12px; border-radius: 4px; font-size: 0.9rem;">
            <strong>Detalle:</strong> <%= reporte.detalle %>
          </p>
        <% end %>

        <table class="tabla-estandar" style="margin: 15px 0;">
          <thead>
            <tr>
              <th>Autor de la reseña</th>
              <th>Reportado por</th>
              <th>Producto</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong><%= autor&.nombre || "Usuario eliminado" %></strong></td>
              <td><strong><%= reporte.cliente.nombre %></strong></td>
              <td><%= link_to review.producto.titulo, producto_path(review.producto) %></td>
            </tr>
          </tbody>
        </table>

        <div class="menu" style="flex-direction: row; margin-top: 10px;">
          <%= button_to "🗑 Eliminar reseña", admin_resena_path(reporte),
                method: :patch, params: { accion: "eliminar" },
                class: "btn btn-secondary",
                data: { confirm: "¿Eliminar esta reseña?" } %>

          <% if autor.present? && !autor.bloqueado? %>
            <%= button_to "🚫 Banear cliente", admin_resena_path(reporte),
                  method: :patch, params: { accion: "banear" },
                  class: "btn btn-secondary",
                  data: { confirm: "¿Banear a #{autor.nombre}?" } %>
          <% elsif autor.present? %>
            <span style="color: #9ca3af; border: 1px solid #ccc; padding: 10px 12px;
                         border-radius: 6px; font-size: 0.88rem;">Ya baneado</span>
          <% end %>

          <%= button_to "Ignorar", admin_resena_path(reporte),
                method: :patch, params: { accion: "ignorar" }, class: "btn" %>
        </div>

      </div>
    <% end %>
  <% end %>

</div>