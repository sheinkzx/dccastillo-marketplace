<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <%= link_to t("admin_resenas.volver"), admin_usuarios_path, class: "btn",
          style: "width: fit-content;" %>
      <h1 style="margin-top: 10px;"><%= t("admin_resenas.titulo") %></h1>
      <p><%= t("admin_resenas.subtitulo") %></p>
    </div>
    <span style="background-color: #dc3545; color: white; font-weight: bold;
                 padding: 6px 14px; border-radius: 999px; font-size: 0.9rem;">
      <%= t("admin_resenas.pendientes", count: @reportes.size) %>
    </span>
  </div>

  <% if @reportes.empty? %>
    <p class="success"><%= t("admin_resenas.sin_reportes") %></p>

  <% else %>
    <% @reportes.each do |reporte| %>
      <% review = reporte.producto_review %>
      <% autor  = review.user %>
      <div class="info-box" style="margin-top: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <h2 style="color: #b45309;">⚑ <%= reporte.motivo %></h2>
          <small><%= reporte.created_at.strftime("%-d %b %Y, %H:%M") %></small>
        </div>
        <blockquote style="border-left: 4px solid #b45309; margin: 10px 0; padding: 10px 15px;
                           background: var(--color-fondo); border-radius: 4px;
                           font-style: italic; color: var(--color-texto);">
          "<%= review.txt %>"

          <% if review.respond_to?(:puntaje) %>
            <div style="margin-top: 6px;">
              <% review.puntaje.times do %><span class="estrella-llena">★</span><% end %>
              <% (5 - review.puntaje).times do %><span class="estrella-vacia">★</span><% end %>
            </div>
          <% end %>
        </blockquote>

        <% if reporte.detalle.present? %>
          <p style="background: var(--color-fondo); color: var(--color-texto);
                    padding: 10px 14px; border-radius: 6px; font-size: 0.9rem;
                    border-left: 4px solid #b45309;">
            <strong><%= t("admin_resenas.detalle") %>:</strong> <%= reporte.detalle %>
          </p>
        <% end %>

        <table class="tabla-estandar" style="margin: 15px 0;">
          <thead>
            <tr>
              <th><%= t("admin_resenas.tabla.autor") %></th>
              <th><%= t("admin_resenas.tabla.reportado_por") %></th>
              <th><%= t("admin_resenas.tabla.producto") %></th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td><strong><%= autor&.nombre || t("admin_resenas.usuario_eliminado") %></strong></td>
              <td><strong><%= reporte.cliente.nombre %></strong></td>
              <td><%= link_to review.producto.titulo, producto_path(review.producto) %></td>
            </tr>
          </tbody>
        </table>
        
        <div class="menu" style="flex-direction: row; margin-top: 10px;">
          <%= button_to t("admin_resenas.eliminar_resena"), admin_resena_path(reporte),
                method: :patch, params: { accion: "eliminar" },
                class: "btn btn-secondary",
                data: { confirm: t("admin_resenas.confirmar_eliminar") } %>
          <% if autor.present? && !autor.bloqueado? %>
            <%= button_to t("admin_resenas.banear_cliente"), admin_resena_path(reporte),
                  method: :patch, params: { accion: "banear" },
                  class: "btn btn-secondary",
                  data: { confirm: t("admin_resenas.confirmar_banear", nombre: autor.nombre) } %>
          <% elsif autor.present? %>
            <span style="color: #9ca3af; border: 1px solid #ccc; padding: 10px 12px;
                         border-radius: 6px; font-size: 0.88rem;"><%= t("admin_resenas.ya_baneado") %></span>
          <% end %>
          <%= button_to t("admin_resenas.ignorar"), admin_resena_path(reporte),
                method: :patch, params: { accion: "ignorar" }, class: "btn" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
