
<header>
  <div><a href="/">🏰 DCCastillo del Juguete 🧸</a></div>
</header>
<nav>
  <ul>
    <li><a href="/productos">Catálogo general</a></li>
    <li><a href="/mis_favoritos">Mis favoritos</a></li>
  </ul>
</nav>

<main style="text-align: center;">
  <h1>Mis Juguetes Favoritos ❤️</h1>
  
  <% if @favoritos.any? %>
    <% @favoritos.each do |favorito| %>
      <% producto = favorito.producto %>
      
      <div style="border: 1px solid #ff9999; padding: 15px; margin: 10px; display: inline-block; border-radius: 10px; background-color: #fff5f5;">
        <strong><a href="/productos/<%= producto.id %>" style="color: #cc0000;"><%= producto.titulo %></a></strong><br><br>
        Precio: $<%= producto.precio %><br>
        Estado: <strong><%= producto.estado %></strong>
        
        <div style="margin-top: 15px;">
          <%# Botón rápido para quitarlo desde la misma lista %>
          <%= button_to "💔 Quitar de la lista", "/productos/#{producto.id}/favorito", method: :delete, style: "background: white; border: 1px solid red; color: red; padding: 5px 10px; border-radius: 5px; cursor: pointer;" %>
        </div>
      </div>
    <% end %>
    
  <% else %>
    <p>Aún no tienes juguetes en tu lista de favoritos.</p>
    <br>
    <a href="/productos" style="padding: 10px; background-color: #3498db; color: white; text-decoration: none; border-radius: 5px;">Ir a buscar juguetes 🚀</a>
  <% end %>
</main>