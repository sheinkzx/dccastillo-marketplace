<div class="container">
  <h1>Mis Juguetes Favoritos ❤️</h1>

  <%= link_to "← Volver al inicio", root_path, class: "btn",
      style: "align-self: flex-start; width: fit-content;" %>

  <% if @favoritos.any? %>
    <table class="tabla-estandar">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Precio</th>
          <th>Categoría</th>
          <th>Edad sugerida</th>
          <th>Estado</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <% @favoritos.each do |favorito| %>
          <% producto = favorito.producto %>
          <tr>
            <td><strong><a href="/productos/<%= producto.id %>"><%= producto.titulo %></a></strong></td>
            <td>$<%= number_with_delimiter(producto.precio.to_i, delimiter: '.') %></td>
            <td><%= producto.categoria %></td>
            <td>De <%= producto.edad_minima %> a <%= producto.edad_maxima %> años</td>
            <td><strong><%= producto.estado %></strong></td>
            <td>
              <%= button_to "💔 Quitar", "/productos/#{producto.id}/favorito",
                  method: :delete, class: "btn btn-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Aún no tienes juguetes en tu lista de favoritos.</p>
    <%= link_to "Ir a buscar juguetes 🚀", "/productos", class: "btn" %>
  <% end %>
</div>