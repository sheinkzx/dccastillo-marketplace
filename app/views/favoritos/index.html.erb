<div class="container">
  <h1><%= t("favoritos.titulo") %></h1>

  <%= link_to t("favoritos.volver"), root_path, class: "btn",
      style: "align-self: flex-start; width: fit-content;" %>

  <% if @favoritos.any? %>
    <table class="tabla-estandar">
      <thead>
        <tr>
          <th><%= t("favoritos.tabla.producto") %></th>
          <th><%= t("favoritos.tabla.precio") %></th>
          <th><%= t("favoritos.tabla.categoria") %></th>
          <th><%= t("favoritos.tabla.edad_sugerida") %></th>
          <th><%= t("favoritos.tabla.estado") %></th>
          <th><%= t("favoritos.tabla.accion") %></th>
        </tr>
      </thead>
      <tbody>
        <% @favoritos.each do |favorito| %>
          <% producto = favorito.producto %>
          <tr>
            <td><strong><a href="/productos/<%= producto.id %>"><%= producto.titulo %></a></strong></td>
            <td>$<%= number_with_delimiter(producto.precio.to_i, delimiter: '.') %></td>
            <td><%= producto.categoria %></td>
            <td><%= t("favoritos.edad_rango", min: producto.edad_minima, max: producto.edad_maxima) %></td>
            <td><strong><%= producto.estado %></strong></td>
            <td>
              <%= button_to t("favoritos.quitar"), "/productos/#{producto.id}/favorito",
                  method: :delete, class: "btn btn-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t("favoritos.sin_favoritos") %></p>
    <%= link_to t("favoritos.ir_a_buscar"), "/productos", class: "btn" %>
  <% end %>
</div>
