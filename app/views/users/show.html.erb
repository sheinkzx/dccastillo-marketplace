<header>
    <div><a href="/">🏰 DCCastillo del Juguete 🧸</a></div>
</header>

<div style="max-width: 900px; margin: 0 auto; padding: 30px 20px; font-family: sans-serif;">
  
  <div style="text-align: center; margin-bottom: 40px;">
    <% if @user.url_foto.present? %>
      <img src="<%= @user.url_foto %>" alt="Avatar" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid #2e83ff; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <% else %>
      <div style="width: 150px; height: 150px; border-radius: 50%; background: #eee; display: inline-flex; align-items: center; justify-content: center; font-size: 60px; border: 4px solid #ccc;">👤</div>
    <% end %>
    
    <h1 style="margin: 15px 0 5px 0; font-size: 2.5em;"><%= @user.nombre %></h1>
    <span style="background-color: #e0f0ff; color: #2e83ff; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 0.9em;"><%= @user.type %></span>
    <p style="color: #666; margin-top: 15px;">Miembro desde <%= @user.created_at.strftime("%B del %Y") %></p>
  </div>

  <% if @user.is_a?(Vendedor) %>
    <h2 style="border-bottom: 2px solid #eaeaea; padding-bottom: 10px; color: #333;">Vitrina de Juguetes (<%= @productos.count %>)</h2>
    
    <% if @productos.any? %>
      <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px;">
        <% @productos.each do |producto| %>
          <div style="border: 1px solid #eaeaea; border-radius: 12px; padding: 20px; width: 250px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: transform 0.2s;">
            <h3 style="margin-top: 0; font-size: 1.2em;">
              <%= link_to producto.titulo, producto_path(producto), style: "text-decoration: none; color: #333;" %>
            </h3>
            <p style="color: #2e83ff; font-size: 1.4em; font-weight: bold; margin: 10px 0;">
              $<%= number_with_delimiter(producto.precio.to_i, delimiter: '.') %>
            </p>
            <p style="font-size: 0.9em; color: #666;">Categoría: <%= producto.categoria %></p>
            <p style="font-size: 0.9em; color: #666;">Stock: <%= producto.stock %></p>
            
            <%= link_to "Ver detalle", producto_path(producto), style: "display: block; text-align: center; margin-top: 15px; padding: 8px 10px; background: #2e83ff; text-decoration: none; border-radius: 6px; color: white; font-weight: bold;" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="background-color: #fafafa; padding: 20px; border-radius: 8px; text-align: center; color: #888;">
        <p>Este vendedor aún no ha publicado juguetes a la venta 🧸</p>
      </div>
    <% end %>
  <% end %>

</div>