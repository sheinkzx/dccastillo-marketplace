<div class="container">
  <h1><%= t("perfil.titulo") %></h1>

  <% foto_actual = @user.url_foto.present? ? @user.url_foto : "https://ui-avatars.com/api/?name=#{URI.encode_www_form_component(@user.nombre)}&background=2c3e50&color=fff&size=100&rounded=true" %>
  <img src="<%= foto_actual %>" alt="Preview"
       style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin: 0 auto 20px; display: block;">

  <%= form_with model: @user, url: actualizar_perfil_path, method: :patch, local: true do |f| %>
    <div class="formulario-grid-2x4">

      <div class="form-group">
        <%= f.label :nombre, t("perfil.nombre") %>
        <%= f.text_field :nombre %>
      </div>

      <div class="form-group">
        <%= f.label :email, t("perfil.email") %>
        <%= f.email_field :email %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :url_foto, t("perfil.url_foto") %>
        <%= f.url_field :url_foto, placeholder: "https://..." %>
      </div>

      <div class="form-group">
        <%= f.label :password, t("perfil.password") %>
        <%= f.password_field :password, autocomplete: "new-password",
            placeholder: t("perfil.placeholder_password") %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, t("perfil.password_confirmation") %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="grid-full">
        <%= f.submit t("perfil.guardar"), class: "btn" %>
      </div>

    </div>
  <% end %>

  <% if flash[:alert] %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>

  <% if flash[:notice] %>
    <p class="success"><%= flash[:notice] %></p>
  <% end %>
</div>
