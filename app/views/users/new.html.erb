

<div class="container">
  <h1><%= t("registro.titulo") %></h1>

  <%= form_with model: @user, url: users_path, local: true, class: "formulario" do |f| %>
    <label><%= t("registro.nombre") %></label>
    <%= f.text_field :nombre %>

    <label><%= t("registro.email") %></label>
    <%= f.email_field :email %>

    <label><%= t("registro.quiero_ser") %></label>
    <%= f.select :type, [
      [t("registro.roles.cliente"),       "Cliente"      ],
      [t("registro.roles.vendedor"),      "Vendedor"     ],
      [t("registro.roles.administrador"), "Administrador"]
    ] %>

    <label><%= t("registro.contrasena") %></label>
    <%= f.password_field :password %>

    <%= f.submit t("registro.crear_cuenta"), class: "btn" %>
  <% end %>

  <% if flash[:alert] %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>
</div>
