

<h1>Regístrate en DCCastillo</h1>

<%= form_with model: @user, url: users_path, local: true do |f| %>
  <%# Model: @user le dice al formulario que use la "caja vacía" que creamos en el controlador users_controllers.rb %>

  <div>
    <%= f.label :nombre %><br>
    <%= f.text_field :nombre %>
  </div>

  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :type, "Quiero ser:" %><br>  
    <%= f.select :type, [["Cliente", "Cliente"], ["Vendedor", "Vendedor"], ["Administrador", "Administrador"]] %>
  </div>

  <div>
    <%= f.label :password, "Contraseña" %><br>
    <%= f.password_field :password %>
  </div>

  <%= f.submit "Crear cuenta" %>
<% end %>