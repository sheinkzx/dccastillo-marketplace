

<div class="container">
  <h1>Regístrate en DCCastillo</h1>

  <%= form_with model: @user, url: users_path, local: true, class: "formulario" do |f| %>

    <label>Nombre</label>
    <%= f.text_field :nombre %>

    <label>Email</label>
    <%= f.email_field :email %>

    <label>Quiero ser:</label>
    <%= f.select :type, [["Cliente", "Cliente"], ["Vendedor", "Vendedor"], ["Administrador", "Administrador"]] %>

    <label>Contraseña</label>
    <%= f.password_field :password %>

    <%= f.submit "Crear cuenta", class: "btn" %>

  <% end %>

  <% if flash[:alert] %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>
</div>