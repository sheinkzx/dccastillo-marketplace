<header>
    <div><a href="/">🏰 DCCastillo del Juguete 🧸</a></div>
</header>
<nav>
    <ul>
        <li><a href="/productos">Catálogo</a></li>
    </ul>
    <form action="/productos" method="get">
        <input type="search" name="q" placeholder="Buscar productos" />
        <button type="submit">Buscar</button>
    </form>
</nav>
<h1><%= @producto.titulo %></h1>
<p><strong>Descripción:</strong> <%= @producto.descripcion %></p>
<h2>Ficha técnica</h2>
<ul>
    <li><strong>Precio:</strong> $<%= number_with_delimiter(@producto.precio.to_i, delimiter: '.') %></li>
    <li><strong>Marca:</strong> <%= @producto.marca %></li>
    <li><strong>Stock:</strong> <%= number_with_delimiter(@producto.stock, delimiter: '.') %></li><!--
    <li><strong>Vendido por:</strong> <a href="/vendedor/<%= @producto.vendedor_id%>"><%= @producto.vendedor_id %></a></li>
    --><li><strong>Fecha de publicación:</strong> <%= @producto.created_at.strftime("%d de %B de %Y") %>.</li>
</ul>
<%# Solo mostramos el botón si hay un cliente logueado y un vendedor no puede comprarse su propio producto %>
<% if current_user&.is_a?(Cliente) %>

<%# RU 25 Mostrar corazon de favorito %>
  <% favorito = current_user.favoritos.find_by(producto_id: @producto.id) %> 
  <div style="margin-bottom: 15px;">
    <% if favorito %>
      <%# Si ya es favorito, mostramos corazón lleno y método DELETE %>
      <%= button_to "❤️ Quitar de favoritos", "/productos/#{@producto.id}/favorito", method: :delete, style: "background: none; border: 1px solid #ccc; padding: 5px 10px; border-radius: 5px; cursor: pointer;" %>
    <% else %>
      <%# Si no es favorito, mostramos corazón vacío y método POST %>
      <%= button_to "🤍 Guardar como favorito", "/productos/#{@producto.id}/favorito", method: :post, style: "background: none; border: 1px solid #ccc; padding: 5px 10px; border-radius: 5px; cursor: pointer;" %>
    <% end %>
  </div>

  <% if @producto.stock > 0 %>
    <%= button_to "🛒 Comprar", "/compras", method: :post,
        params: { producto_id: @producto.id },
        data: { turbo_confirm: "¿Confirmas la compra de #{@producto.titulo}?" } %>
  <% else %>
    <p style="color: red; font-weight: bold;">❌ Sin Stock</p>
    <button disabled style="opacity: 0.5; cursor: not-allowed;">🛒 Sin Stock</button>
  <% end %>
<% end %>
