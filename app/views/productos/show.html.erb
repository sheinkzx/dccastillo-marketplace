<div class="container">

  <%# ── Ficha del producto ── %>
  <h1><%= @producto.titulo %></h1>

  <div class="info-box">
    <h2><%= t("productos.show.ficha_tecnica") %></h2>

    <%# ── Avatar del vendedor ── %>
    <% vendedor = @producto.respond_to?(:vendedor) ? @producto.vendedor : @producto.user %>
    <% if vendedor %>
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; padding: 12px; border: 1px solid #eaeaea; border-radius: 8px; background-color: #f8f9fa;">
        <% if vendedor.url_foto.present? %>
          <img src="<%= vendedor.url_foto %>" alt="Foto" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;">
        <% else %>
          <div style="width: 50px; height: 50px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; font-size: 24px;">👤</div>
        <% end %>
        <div>
          <small style="color: #666;">Vendido y enviado por:</small><br>
          <%= link_to vendedor.nombre, perfil_publico_path(vendedor), style: "font-weight: bold; font-size: 1.1em;" %>
        </div>
      </div>
    <% end %>

    <div class="formulario-grid-2x4">
      <div class="form-group">
        <label><%= t("productos.show.precio") %></label>
        <p>$<%= number_with_delimiter(@producto.precio.to_i, delimiter: '.') %></p>
      </div>
      <div class="form-group">
        <label><%= t("productos.show.marca") %></label>
        <p><%= @producto.marca %></p>
      </div>
      <div class="form-group">
        <label><%= t("productos.show.categoria") %></label>
        <p><%= @producto.categoria %></p>
      </div>
      <div class="form-group">
        <label><%= t("productos.show.edad_sugerida") %></label>
        <p><%= t("productos.show.edad_rango", min: @producto.edad_minima, max: @producto.edad_maxima) %></p>
      </div>
      <div class="form-group">
        <label><%= t("productos.show.stock") %></label>
        <p><%= number_with_delimiter(@producto.stock, delimiter: '.') %></p>
      </div>
      <div class="form-group">
        <label><%= t("productos.show.publicado_el") %></label>
        <p><%= @producto.created_at.strftime("%d de %B de %Y") %></p>
      </div>
      <div class="form-group" style="grid-column: span 2;">
        <label><%= t("productos.show.descripcion") %></label>
        <p><%= @producto.descripcion %></p>
      </div>
    </div>
  </div>

  <%# ── Acciones del cliente ── %>
  <% if current_user&.is_a?(Cliente) %>
    <div class="info-box" style="margin-top: 20px;">
      <h2><%= t("productos.show.acciones") %></h2>
      <div class="menu">
        <% favorito = current_user.favoritos.find_by(producto_id: @producto.id) %>
        <% if favorito %>
          <%= button_to t("productos.show.quitar_favorito"), "/productos/#{@producto.id}/favorito",
              method: :delete, class: "btn btn-secondary" %>
        <% else %>
          <%= button_to t("productos.show.guardar_favorito"), "/productos/#{@producto.id}/favorito",
              method: :post, class: "btn" %>
        <% end %>

        <% if @producto.estado == "Activo" && @producto.stock > 0 %>
          <%= button_to t("productos.show.comprar"), "/compras", method: :post,
              params: { producto_id: @producto.id },
              data: { turbo_confirm: t("productos.show.confirmar_compra", titulo: @producto.titulo) },
              class: "btn" %>
        <% elsif @producto.estado == "Inactivo" %>
          <p class="error"><%= t("productos.show.pausado") %></p>
        <% else %>
          <p class="error"><%= t("productos.show.sin_stock") %></p>
        <% end %>

        <%= button_to "💬 Preguntar al vendedor", conversations_path(producto_id: @producto.id),
            method: :post, class: "btn" %>
      </div>
    </div>
  <% end %>

  <%# ── Reseñas ── %>
  <div class="info-box" style="margin-top: 20px;">
    <h2><%= t("productos.show.resenas") %></h2>

    <% if @ha_comprado %>
      <h2 style="margin-top: 20px;"><%= t("productos.show.escribir_resena") %></h2>
      <%= form_with model: Producto::Review.new,
          url: producto_reviews_path(@producto),
          data: { turbo: false },
          class: "formulario" do |f| %>
        <label><%= t("productos.show.puntaje") %></label>
        <%= f.select :puntaje, [1, 2, 3, 4, 5], selected: 5 %>
        <label><%= t("productos.show.comentario") %></label>
        <%= f.text_area :txt, required: true, rows: 4,
            style: "padding: 10px; border: 1px solid #ccc; border-radius: 6px;" %>
        <%= f.submit t("productos.show.publicar_resena"), class: "btn" %>
      <% end %>
    <% end %>

    <% if @producto.reviews.any? %>
      <table class="tabla-estandar" style="margin-top: 20px;">
        <thead>
          <tr>
            <th><%= t("productos.show.tabla.puntaje") %></th>
            <th><%= t("productos.show.tabla.comentario") %></th>
            <th><%= t("productos.show.tabla.autor") %></th>
            <th><%= t("productos.show.tabla.fecha") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @producto.reviews.each do |review| %>
            <tr>
              <td>
                <% review.puntaje.times do %>
                  <span class="estrella-llena">★</span>
                <% end %>
                <% (5 - review.puntaje).times do %>
                  <span class="estrella-vacia">★</span>
                <% end %>
              </td>
              <td><%= simple_format(review.txt) %></td>
              <td><%= review.user.nombre %></td>
              <td><%= review.created_at.strftime("%d/%m/%Y") %></td>
              <td>
                <% if current_user&.is_a?(Cliente) && review.user != current_user %>
                  <div>
                    <button type="button"
                      class="btn btn-secondary"
                      title="<%= t('productos.show.reportar_resena') %>"
                      onclick="document.getElementById('modal-reporte-<%= review.id %>').style.display='block'">
                      ⚑
                    </button>

                    <div id="modal-reporte-<%= review.id %>" style="display:none; margin-top: 8px;">
                      <div class="info-box">
                        <h2><%= t("productos.show.reportar_resena") %></h2>
                        <%= form_with url: crear_reporte_path(@producto, review),
                            method: :post, data: { turbo: false }, class: "formulario" do |f| %>
                          <label><%= t("productos.show.motivo") %></label>
                          <%= f.select "reporte[motivo]", Reporte::MOTIVOS,
                                { prompt: t("productos.show.motivo_prompt") }, { required: true } %>
                          <label><%= t("productos.show.detalle") %></label>
                          <%= f.text_area "reporte[detalle]", rows: 2,
                              style: "padding: 8px; border: 1px solid #ccc; border-radius: 6px;" %>
                          <div class="menu" style="margin-top: 10px;">
                            <%= f.submit t("productos.show.enviar_reporte"), class: "btn btn-secondary" %>
                            <button type="button" class="btn"
                              onclick="document.getElementById('modal-reporte-<%= review.id %>').style.display='none'">
                              <%= t("productos.show.cancelar") %>
                            </button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><%= t("productos.show.sin_resenas") %></p>
    <% end %>
  </div>

</div>
