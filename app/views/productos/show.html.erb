<div class="container">

  <%# ── Ficha del producto ── %>
  <h1><%= @producto.titulo %></h1>

  <div class="info-box">
    <h2>Ficha técnica</h2>
    <div class="formulario-grid-2x4">
      <div class="form-group">
        <label>Precio</label>
        <p>$<%= number_with_delimiter(@producto.precio.to_i, delimiter: '.') %></p>
      </div>
      <div class="form-group">
        <label>Marca</label>
        <p><%= @producto.marca %></p>
      </div>
      <div class="form-group">
        <label>Categoría</label>
        <p><%= @producto.categoria %></p>
      </div>
      <div class="form-group">
        <label>Edad sugerida</label>
        <p>De <%= @producto.edad_minima %> a <%= @producto.edad_maxima %> años</p>
      </div>
      <div class="form-group">
        <label>Stock</label>
        <p><%= number_with_delimiter(@producto.stock, delimiter: '.') %></p>
      </div>
      <div class="form-group">
        <label>Publicado el</label>
        <p><%= @producto.created_at.strftime("%d de %B de %Y") %></p>
      </div>
      <div class="form-group" style="grid-column: span 2;">
        <label>Descripción</label>
        <p><%= @producto.descripcion %></p>
      </div>
    </div>
  </div>

  <%# ── Acciones del cliente ── %>
  <% if current_user&.is_a?(Cliente) %>
    <div class="info-box" style="margin-top: 20px;">
      <h2>Acciones</h2>
      <div class="menu">
        <% favorito = current_user.favoritos.find_by(producto_id: @producto.id) %>
        <% if favorito %>
          <%= button_to "❤️ Quitar de favoritos", "/productos/#{@producto.id}/favorito",
              method: :delete, class: "btn btn-secondary" %>
        <% else %>
          <%= button_to "🤍 Guardar como favorito", "/productos/#{@producto.id}/favorito",
              method: :post, class: "btn" %>
        <% end %>

        <% if @producto.estado == "Activo" && @producto.stock > 0 %>
          <%= button_to "🛒 Comprar", "/compras", method: :post,
              params: { producto_id: @producto.id },
              data: { turbo_confirm: "¿Confirmas la compra de #{@producto.titulo}?" },
              class: "btn" %>
        <% elsif @producto.estado == "Inactivo" %>
          <p class="error">⏸️ Producto Pausado</p>
        <% else %>
          <p class="error">❌ Sin Stock</p>
        <% end %>

        <%= button_to "💬 Preguntar al vendedor", conversations_path(producto_id: @producto.id),
            method: :post, class: "btn" %>
      </div>
    </div>
  <% end %>

  <%# ── Reseñas ── %>
  <div class="info-box" style="margin-top: 20px;">
    <h2>Reseñas</h2>

    <% if @ha_comprado %>
      <h2 style="margin-top: 20px;">Escribir reseña</h2>
      <%= form_with model: Producto::Review.new,
          url: producto_reviews_path(@producto),
          data: { turbo: false },
          class: "formulario" do |f| %>
        <label>Puntaje</label>
        <%= f.select :puntaje, [1, 2, 3, 4, 5], selected: 5 %>
        <label>Comentario</label>
        <%= f.text_area :txt, required: true, rows: 4,
            style: "padding: 10px; border: 1px solid #ccc; border-radius: 6px;" %>
        <%= f.submit "Publicar reseña", class: "btn" %>
      <% end %>
    <% end %>

    <% if @producto.reviews.any? %>
      <table class="tabla-estandar" style="margin-top: 20px;">
        <thead>
          <tr>
            <th>Puntaje</th>
            <th>Comentario</th>
            <th>Autor</th>
            <th>Fecha</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @producto.reviews.each do |review| %>
            <tr>
              <td>
                <% review.puntaje.times do %>
                  <span class="estrella-llena">★</span>
                <% end %>
                <% (5 - review.puntaje).times do %>
                  <span class="estrella-vacia">★</span>
                <% end %>
              </td>
              <td><%= simple_format(review.txt) %></td>
              <td><%= review.user.nombre %></td>
              <td><%= review.created_at.strftime("%d/%m/%Y") %></td>
              <td>
                <% if current_user&.is_a?(Cliente) && review.user != current_user %>
                  <div>
                    <%= button_to "⚑", crear_reporte_path(@producto, review),
                          method: :post,
                          params: { reporte: { motivo: "" } },
                          data: { turbo: false },
                          title: "Reportar reseña",
                          class: "btn btn-secondary",
                          onclick: "this.closest('form').remove(); document.getElementById('modal-reporte-#{review.id}').style.display='block'; return false;" %>

                    <div id="modal-reporte-<%= review.id %>" style="display: none; margin-top: 8px;">
                      <div class="info-box">
                        <h2>Reportar reseña</h2>
                        <%= form_with url: crear_reporte_path(@producto, review),
                            method: :post, data: { turbo: false }, class: "formulario" do |f| %>
                          <label>Motivo</label>
                          <%= f.select "reporte[motivo]", Reporte::MOTIVOS,
                                { prompt: "Selecciona un motivo" }, { required: true } %>
                          <label>Detalle (opcional)</label>
                          <%= f.text_area "reporte[detalle]", rows: 2,
                              style: "padding: 8px; border: 1px solid #ccc; border-radius: 6px;" %>
                          <div class="menu" style="margin-top: 10px;">
                            <%= f.submit "Enviar reporte", class: "btn btn-secondary" %>
                            <button type="button" class="btn"
                              onclick="document.getElementById('modal-reporte-<%= review.id %>').style.display='none'">
                              Cancelar
                            </button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>Aún no hay reseñas para este producto.</p>
    <% end %>
  </div>

</div>