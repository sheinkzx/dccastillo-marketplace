<div class="container">
  <h1>Editar Producto: <%= @producto.titulo %></h1>

  <%= form_with model: @producto, url: "/productos/#{@producto.id}", method: :patch, local: true do |f| %>
    <div class="formulario-grid-2x4">

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :titulo, "Título del juguete" %>
        <%= f.text_field :titulo %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :descripcion, "Descripción" %>
        <%= f.text_area :descripcion, rows: 4, style: "padding: 10px; border: 1px solid #ccc; border-radius: 6px;" %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :precio, "Precio ($)" %>
        <%= f.number_field :precio, min: 0, step: 1 %>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <div class="info-box">
          <h2 style="color: #dc3545;">⚙️ Configuración de Filtros</h2>
          <div class="formulario-grid-2x4">

            <div class="form-group">
              <%= f.label :edad_minima, "Edad mínima sugerida" %>
              <%= f.number_field :edad_minima, min: 0 %>
            </div>

            <div class="form-group">
              <%= f.label :edad_maxima, "Edad máxima sugerida" %>
              <%= f.number_field :edad_maxima, min: 0 %>
            </div>

            <div class="form-group" style="grid-column: span 2;">
              <%= f.label :categoria, "Categoría" %>
              <%= f.select :categoria, [
                ["Selecciona una",        ""            ],
                ["Imitación/Simbólicos",  "Imitación"   ],
                ["Construcción",          "Construcción"],
                ["Educativos/Didácticos", "Educativos"  ],
                ["Artísticos",            "Artísticos"  ],
                ["Movimiento",            "Movimiento"  ],
                ["Tecnológicos",          "Tecnológicos"],
                ["Otro / Varios",         "Otro"        ]
              ] %>
            </div>

          </div>
        </div>
      </div>

      <div class="form-group" style="grid-column: span 2;">
        <%= f.label :estado, "Estado del producto" %>
        <%= f.select :estado, [["Activo", "Activo"], ["Inactivo", "Inactivo"]] %>
      </div>

      <div class="grid-full">
        <%= f.submit "Guardar cambios", class: "btn" %>
        <%= link_to "Cancelar", root_path, class: "btn btn-secondary" %>
      </div>

    </div>
  <% end %>
</div>