<%# ── ENVOLTURA PRINCIPAL PARA ARREGLAR EL FLEXBOX ANTIGUO ── %>
<div style="width: 100%; display: flex; flex-direction: column; align-items: stretch;">

  <%# ── 1. TÍTULO CENTRADO ARRIBA ── %>
  <div style="text-align: center; margin-bottom: 40px; margin-top: 20px;">
    <h1 style="font-size: 2.8rem; color: var(--color-primario); margin-bottom: 10px;">🧸 <%= t("productos.catalogo.titulo", default: "Catálogo de Juguetes") %></h1>
    <p style="color: var(--color-texto); opacity: 0.8; font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Encuentra el regalo perfecto. Busca por palabra clave, edad recomendada o rango de precio.</p>
  </div>

  <%# ── 2. CAJA DE FILTROS CENTRADA ── %>
  <div style="max-width: 900px; margin: 0 auto 40px auto; background: var(--color-blanco); padding: 25px; border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--color-borde); width: 100%; box-sizing: border-box;">
    <h2 style="margin-top: 0; color: var(--color-texto); font-size: 1.2rem; margin-bottom: 20px;"><%= t("productos.catalogo.buscar_filtrar", default: "🔍 Buscar y filtrar") %></h2>
    
    <%= form_with url: productos_path, method: :get, local: true, style: "display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end; justify-content: center;" do |f| %>
      
      <div style="flex: 1; min-width: 180px;">
        <%= f.label :query, t("productos.catalogo.palabra_clave", default: "Palabra clave"), style: "display: block; font-weight: bold; margin-bottom: 5px; color: #64748B; font-size: 0.9rem;" %>
        <%= f.text_field :query, value: params[:query], placeholder: t("productos.catalogo.placeholder_buscar", default: "Buscar juguete..."), style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--color-borde); outline: none; background: transparent; color: var(--color-texto); box-sizing: border-box;" %>
      </div>

      <div style="flex: 1; min-width: 130px;">
        <%= f.label :precio_max, t("productos.catalogo.precio_max", default: "Precio Máx ($)"), style: "display: block; font-weight: bold; margin-bottom: 5px; color: #64748B; font-size: 0.9rem;" %>
        <%= f.number_field :precio_max, value: params[:precio_max], placeholder: t("productos.catalogo.placeholder_precio", default: "Ej: 10000"), style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--color-borde); outline: none; background: transparent; color: var(--color-texto); box-sizing: border-box;" %>
      </div>

      <div style="flex: 1; min-width: 130px;">
        <%= f.label :edad, t("productos.catalogo.edad", default: "Edad"), style: "display: block; font-weight: bold; margin-bottom: 5px; color: #64748B; font-size: 0.9rem;" %>
        <%= f.number_field :edad, value: params[:edad], placeholder: t("productos.catalogo.placeholder_edad", default: "Ej: 5"), style: "width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--color-borde); outline: none; background: transparent; color: var(--color-texto); box-sizing: border-box;" %>
      </div>

      <div style="display: flex; gap: 10px;">
        <%= f.submit t("productos.catalogo.filtrar", default: "🔍 Filtrar"), class: "btn-primary", style: "padding: 10px 20px; border-radius: 8px; height: 42px;" %>
        
        <% if params[:query].present? || params[:precio_max].present? || params[:edad].present? || params[:categoria].present? %>
          <%= link_to t("productos.catalogo.ver_todo", default: "🔄 Ver todo"), productos_path, class: "btn-outline", style: "padding: 10px 20px; border-radius: 8px; display: flex; align-items: center; height: 42px; box-sizing: border-box;" %>
        <% end %>
      </div>
      
    <% end %>
  </div>

  <%# ── 3. VITRINA DE JUGUETES (GRILLA) ── %>
  <% if @productos.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 30px; margin-bottom: 50px;">
      
      <% @productos.each do |producto| %>
        <div style="border: 1px solid var(--color-borde); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-md); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; background-color: var(--color-blanco);">
          
          <%# ZONA DE IMAGEN %>
          <%= link_to producto_path(producto), style: "display: block; height: 220px; background-color: var(--color-fondo); overflow: hidden; text-decoration: none;" do %>
            <% if producto.url_imagen.present? %>
              <img src="<%= producto.url_imagen %>" alt="<%= producto.titulo %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
            <% else %>
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 5rem; color: var(--color-borde);">🧸</div>
            <% end %>
          <% end %>
          
          <%# ZONA DE INFORMACIÓN %>
          <div style="padding: 20px; display: flex; flex-direction: column; flex-grow: 1;">
            
            <h3 style="margin: 0 0 8px 0; font-size: 1.1em; line-height: 1.3; height: 2.6em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;" title="<%= producto.titulo %>">
              <%= link_to producto.titulo, producto_path(producto), style: "text-decoration: none; color: var(--color-texto);" %>
            </h3>
            
            <p style="color: var(--color-primario); font-size: 1.4em; font-weight: 900; margin: 0 0 12px 0;">
              $<%= number_with_delimiter(producto.precio.to_i, delimiter: '.') %>
            </p>
            
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.75em; font-weight: bold; color: #64748B; background: var(--color-fondo); padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">
                <%= producto.categoria %>
              </span>
              <span style="font-size: 0.8em; color: <%= producto.stock.to_i > 0 ? '#10B981' : '#EF4444' %>; font-weight: 800;">
                <%= producto.stock.to_i > 0 ? "Stock: #{producto.stock}" : "Agotado" %>
              </span>
            </div>
            
            <%# PARTE INFERIOR (VENDEDOR Y BOTONES) %>
            <div style="margin-top: auto;">
              <% vendedor = producto.respond_to?(:vendedor) ? producto.vendedor : producto.user %>
              <% if vendedor %>
                <div style="display: flex; align-items: center; gap: 10px; margin-top: 15px; border-top: 1px solid var(--color-borde); padding-top: 15px; margin-bottom: 15px;">
                  <% if vendedor.url_foto.present? %>
                    <img src="<%= vendedor.url_foto %>" alt="Foto" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--color-primario);">
                  <% else %>
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-fondo); border: 2px solid var(--color-borde); color: var(--color-texto); display: flex; align-items: center; justify-content: center; font-size: 16px;">👤</div>
                  <% end %>
                  <div style="font-size: 0.8em; color: #64748B; line-height: 1.2;">
                    Vendedor:<br>
                    <%= link_to vendedor.nombre.split.first, perfil_publico_path(vendedor), style: "font-weight: 900; text-decoration: none; color: var(--color-secundario);" %>
                  </div>
                </div>
              <% end %>

              <%= link_to "🔍 Ver Juguete", producto_path(producto), class: "btn-primary", style: "display: block; text-align: center; margin-bottom: 8px;" %>
              
              <% if current_user&.is_a?(Vendedor) && producto.vendedor == current_user %>
                <% if producto.compras.any? %>
                    <button disabled style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid var(--color-borde); background: var(--color-fondo); color: #94A3B8; cursor: not-allowed; font-weight: bold;">🗑️ Tiene compras</button>
                <% else %>
                    <%= button_to "🗑️ Eliminar", "/productos/#{producto.id}",
                        method: :delete,
                        class: "btn-outline",
                        style: "width: 100%; border-color: #EF4444; color: #EF4444;",
                        onmouseover: "this.style.backgroundColor='#EF4444'; this.style.color='white'",
                        onmouseout: "this.style.backgroundColor='transparent'; this.style.color='#EF4444'",
                        data: { turbo_confirm: "¿Seguro que quieres eliminar #{producto.titulo}?" } %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      
    </div>
  <% else %>

    <%# ── PANTALLA SI NO HAY PRODUCTOS ── %>
    <div style="text-align: center; padding: 50px; background: var(--color-blanco); border-radius: 16px; border: 1px solid var(--color-borde); margin-bottom: 50px;">
      <div style="font-size: 4rem; margin-bottom: 10px;">🕵️‍♂️</div>
      <h3 style="color: var(--color-texto); margin-bottom: 5px;">No encontramos juguetes</h3>
      <p style="color: #64748B;">Intenta buscar con otras palabras o quita algunos filtros.</p>
      <%= link_to "Ver todo el catálogo", productos_path, class: "btn-primary", style: "display: inline-block; margin-top: 15px;" %>
    </div>

  <% end %>

</div>