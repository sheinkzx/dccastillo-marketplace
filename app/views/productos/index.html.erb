<div class="container">

  <%# ── Filtros ── %>
  <div class="info-box">
    <h2><%= t("productos.catalogo.buscar_filtrar") %></h2>
    <form action="/productos" method="get">
      <div class="formulario-grid-2x4">

        <div class="form-group">
          <label><%= t("productos.catalogo.palabra_clave") %></label>
          <input type="search" name="q" placeholder="<%= t('productos.catalogo.placeholder_buscar') %>" value="<%= params[:q] %>">
        </div>

        <div class="form-group">
          <label><%= t("productos.catalogo.precio_max") %></label>
          <input type="number" name="precio_max" placeholder="<%= t('productos.catalogo.placeholder_precio') %>" value="<%= params[:precio_max] %>">
        </div>

        <div class="form-group">
          <label><%= t("productos.catalogo.marca") %></label>
          <input type="text" name="marca" placeholder="<%= t('productos.catalogo.placeholder_marca') %>" value="<%= params[:marca] %>">
        </div>

        <div class="form-group">
          <label><%= t("productos.catalogo.edad") %></label>
          <input type="number" name="edad_cliente" placeholder="<%= t('productos.catalogo.placeholder_edad') %>" value="<%= params[:edad_cliente] %>">
        </div>

        <div class="form-group" style="grid-column: span 2;">
          <label><%= t("productos.catalogo.categorias") %></label>
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 6px;">
            <% [
              ["Imitación",    t("productos.editar.categorias.imitacion")   ],
              ["Construcción", t("productos.editar.categorias.construccion")],
              ["Educativos",   t("productos.editar.categorias.educativos")  ],
              ["Artísticos",   t("productos.editar.categorias.artisticos")  ],
              ["Movimiento",   t("productos.editar.categorias.movimiento")  ],
              ["Tecnológicos", t("productos.editar.categorias.tecnologicos")],
              ["Otro",         t("productos.editar.categorias.otro")        ]
            ].each do |valor, etiqueta| %>
              <label style="display: flex; align-items: center; gap: 6px; font-weight: normal;">
                <input type="checkbox" name="categorias[]" value="<%= valor %>"
                       <%= 'checked' if params[:categorias]&.include?(valor) %>>
                <%= etiqueta %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="grid-full">
          <button type="submit" class="btn"><%= t("productos.catalogo.filtrar") %></button>
          <%= link_to t("productos.catalogo.ver_todo"), "/productos", class: "btn btn-secondary" %>
        </div>

      </div>
    </form>

    <% if params[:q].present? || params[:precio_max].present? || params[:marca].present? || params[:edad_cliente].present? || params[:categorias].present? %>
      <p class="success"><%= t("productos.catalogo.mostrando_filtrados") %></p>
    <% end %>
  </div>

  <%# ── Catálogo ── %>
  <h1 style="margin-top: 20px;"><%= t("productos.catalogo.titulo") %></h1>

  <% if @productos.any? %>
    <table class="tabla-estandar">
      <thead>
        <tr>
          <th><%= t("productos.catalogo.tabla.producto") %></th>
          <th><%= t("productos.catalogo.tabla.precio") %></th>
          <th><%= t("productos.catalogo.tabla.marca") %></th>
          <th><%= t("productos.catalogo.tabla.categoria") %></th>
          <th><%= t("productos.catalogo.tabla.edad_sugerida") %></th>
          <th><%= t("productos.catalogo.tabla.stock") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @productos.each do |producto| %>
          <% vendedor = producto.respond_to?(:vendedor) ? producto.vendedor : producto.user %>
          <tr>
            <td>
              <strong><a href="/productos/<%= producto.id %>"><%= producto.titulo %></a></strong>
              <br><small><%= producto.descripcion %></small>
              <% if vendedor %>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                  <% if vendedor.url_foto.present? %>
                    <img src="<%= vendedor.url_foto %>" alt="Foto" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
                  <% else %>
                    <div style="width: 28px; height: 28px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; font-size: 14px;">👤</div>
                  <% end %>
                  <small><%= link_to vendedor.nombre, perfil_publico_path(vendedor) %></small>
                </div>
              <% end %>
            </td>
            <td><%= number_to_currency(producto.precio, unit: "$", separator: ",", delimiter: ".", precision: 0) %></td>
            <td><%= producto.marca %></td>
            <td><%= producto.categoria %></td>
            <td><%= t("productos.catalogo.edad_rango", min: producto.edad_minima, max: producto.edad_maxima) %></td>
            <td><%= number_with_delimiter(producto.stock, delimiter: '.') %></td>
            <td>
              <% if current_user&.is_a?(Vendedor) && producto.vendedor == current_user %>
                <%= button_to "🗑️", "/productos/#{producto.id}",
                    method: :delete,
                    data: { turbo_confirm: t("productos.catalogo.confirmar_eliminar", titulo: producto.titulo) },
                    class: "btn btn-secondary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t("productos.catalogo.sin_productos") %></p>
  <% end %>

</div>
