<header>
    <div><a href="/">🏰 DCCastillo del Juguete 🧸</a></div>
</header>
<nav>
    <ul>
        <li><a href="/productos">Catálogo</a></li>
    </ul>
    <form action="/productos" method="get">
        <input type="search" name="q" placeholder="Buscar productos" />
        <button type="submit">Buscar</button>
    </form>
</nav>

<main>
  <h1>Catálogo de juguetes</h1>
  <% if @productos.any? %>
      <% @productos.each do |producto| %>
      <div style="border: 1px solid #ccc; padding: 10px; margin: 10px; display: inline-block;">
          <strong><a href="/productos/<%= producto.id %>"><%= producto.titulo %></a></strong><br />
          <%= producto.descripcion %>
          <ul>
              <li><strong>Precio:</strong> <%= number_to_currency(producto.precio, unit: "$", separator: ",", delimiter: ".", precision: 0) %></li>
              <li><strong>Marca:</strong> <%= producto.marca %></li>
              <li><strong>Stock:</strong> <%= number_with_delimiter(producto.stock, delimiter: '.') %></li>
          </ul>
          <%# Solo el vendedor dueño del producto ve el botón de eliminar %>
          <% if current_user&.is_a?(Vendedor) && producto.vendedor == current_user %>
            <% if producto.compras.any? %>
              <button disabled style="opacity: 0.5; cursor: not-allowed;">🗑️ No se puede eliminar</button>
              <small style="color: red;">Ya tiene compras asociadas</small>
            <% else %>
              <%= button_to "🗑️ Eliminar", "/productos/#{producto.id}", method: :delete,
                  data: { turbo_confirm: "¿Seguro que quieres eliminar #{producto.titulo}?" } %>
            <% end %>
          <% end %>
      </div>
      <% end %>
  <% else %>
      <p>No hay productos disponibles.</p>
  <% end %>
</main>