<div class="container">

  <%# ── Filtros ── %>
  <div class="info-box">
    <h2>🔍 Buscar y filtrar</h2>
    <form action="/productos" method="get">
      <div class="formulario-grid-2x4">

        <div class="form-group">
          <label>Palabra clave</label>
          <input type="search" name="q" placeholder="Buscar juguete..." value="<%= params[:q] %>">
        </div>

        <div class="form-group">
          <label>Precio Máximo ($)</label>
          <input type="number" name="precio_max" placeholder="Ej: 10000" value="<%= params[:precio_max] %>">
        </div>

        <div class="form-group">
          <label>Marca</label>
          <input type="text" name="marca" placeholder="Ej: Lego" value="<%= params[:marca] %>">
        </div>

        <div class="form-group">
          <label>Edad</label>
          <input type="number" name="edad_cliente" placeholder="Ej: 5" value="<%= params[:edad_cliente] %>">
        </div>

        <div class="form-group" style="grid-column: span 2;">
          <label>Categorías</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 6px;">
            <% [["Imitación","Imitación"], ["Construcción","Construcción"], ["Educativos","Educativos"],
                ["Artísticos","Artísticos"], ["Movimiento","Movimiento"], ["Tecnológicos","Tecnológicos"],
                ["Otro","Otros"]].each do |valor, etiqueta| %>
              <label style="display: flex; align-items: center; gap: 6px; font-weight: normal;">
                <input type="checkbox" name="categorias[]" value="<%= valor %>"
                       <%= 'checked' if params[:categorias]&.include?(valor) %>>
                <%= etiqueta %>
              </label>
            <% end %>
          </div>
        </div>

        <div class="grid-full">
          <button type="submit" class="btn">🔍 Filtrar</button>
          <%= link_to "🔄 Ver todo el catálogo", "/productos", class: "btn btn-secondary" %>
        </div>

      </div>
    </form>

    <% if params[:q].present? || params[:precio_max].present? || params[:marca].present? || params[:edad_cliente].present? || params[:categorias].present? %>
      <p class="success">Mostrando resultados filtrados</p>
    <% end %>
  </div>

  <%# ── Catálogo ── %>
  <h1 style="margin-top: 20px;">Catálogo de juguetes</h1>

  <% if @productos.any? %>
    <table class="tabla-estandar">
      <thead>
        <tr>
          <th>Producto</th>
          <th>Precio</th>
          <th>Marca</th>
          <th>Categoría</th>
          <th>Edad sugerida</th>
          <th>Stock</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @productos.each do |producto| %>
          <tr>
            <td>
              <strong><a href="/productos/<%= producto.id %>"><%= producto.titulo %></a></strong>
              <br><small><%= producto.descripcion %></small>
            </td>
            <td><%= number_to_currency(producto.precio, unit: "$", separator: ",", delimiter: ".", precision: 0) %></td>
            <td><%= producto.marca %></td>
            <td><%= producto.categoria %></td>
            <td>De <%= producto.edad_minima %> a <%= producto.edad_maxima %> años</td>
            <td><%= number_with_delimiter(producto.stock, delimiter: '.') %></td>
            <td>
              <% if current_user&.is_a?(Vendedor) && producto.vendedor == current_user %>
                <% if producto.compras.any? %>
                  <button disabled class="btn" style="opacity: 0.5; cursor: not-allowed;">🗑️ No eliminar</button>
                  <p class="error" style="font-size: 0.8rem;">Ya tiene compras</p>
                <% else %>
                  <%= button_to "🗑️", "/productos/#{producto.id}",
                      method: :delete,
                      data: { turbo_confirm: "¿Seguro que quieres eliminar #{producto.titulo}?" },
                      class: "btn btn-secondary" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No hay productos disponibles.</p>
  <% end %>

</div>