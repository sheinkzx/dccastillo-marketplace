<div class="container" style="width: 70vw; height: auto; padding: 0; overflow: hidden;">

  <div class="chat-header">
    <div>
      <h2>🧸 <%= @conversation.producto.titulo %></h2>
      <p>
        <% si_soy_cliente = current_user.is_a?(Cliente) %>
        Hablando con: <strong><%= si_soy_cliente ? @conversation.vendedor.nombre : @conversation.cliente.nombre %></strong>
      </p>
    </div>
    <%= link_to "Ver producto →", producto_path(@conversation.producto), class: "btn chat-submit" %>
  </div>

  <div class="chat-body">
    <% if @messages.empty? %>
      <p style="text-align: center; color: #888; font-style: italic; margin: auto;">No hay mensajes aún. ¡Escribe el primero!</p>
    <% end %>

    <% @messages.each do |msg| %>
      <% soy_yo = msg.sender == current_user %>
      <div class="<%= soy_yo ? 'chat-bubble-mine' : 'chat-bubble-other' %>">
        <p style="margin: 0;"><%= msg.content %></p>
        <small style="display: block; text-align: right; margin-top: 5px; color: #999;">
          <%= msg.created_at.strftime("%H:%M") %>
        </small>
      </div>
    <% end %>
  </div>

  <div class="chat-footer">
    <%= form_with model: [@conversation, @new_message], local: true, style: "display: flex; gap: 10px; width: 100%;" do |f| %>
      <%= f.text_field :content, placeholder: "Escribe un mensaje...", class: "chat-input", required: true, autocomplete: "off" %>
      <%= f.submit "Enviar 🚀", class: "btn chat-submit" %>
    <% end %>
  </div>

</div>