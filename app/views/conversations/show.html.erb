<header>
  <div><a href="/">🏰 Volver al inicio</a></div>
</header>

<div style="max-width: 600px; margin: 30px auto; border: 1px solid #ddd; border-radius: 10px; overflow: hidden; font-family: sans-serif;">
  
  <div style="background-color: #2e83ff; color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h3 style="margin: 0;">Chat sobre: <%= @conversation.producto.titulo %></h3>
      <p style="margin: 5px 0 0 0; font-size: 0.85em;">
        <% si_soy_cliente = current_user.is_a?(Cliente) %>
        Hablando con: <strong><%= si_soy_cliente ? @conversation.vendedor.nombre : @conversation.cliente.nombre %></strong>
      </p>
    </div>
    <%= link_to "Ver producto", producto_path(@conversation.producto), style: "color: white; text-decoration: underline; font-size: 0.9em;" %>
  </div>

  <div style="height: 400px; overflow-y: scroll; padding: 20px; background-color: #f5f5f5; display: flex; flex-direction: column; gap: 10px;">
    <% if @messages.empty? %>
      <p style="text-align: center; color: #888; font-style: italic; margin-top: auto; margin-bottom: auto;">No hay mensajes aún. ¡Escribe el primero!</p>
    <% end %>

    <% @messages.each do |msg| %>
      <% soy_yo = msg.sender == current_user %>
      <div style="max-width: 75%; padding: 10px 15px; border-radius: 15px; <%= soy_yo ? 'align-self: flex-end; background-color: #dcf8c6; border-bottom-right-radius: 2px;' : 'align-self: flex-start; background-color: white; border: 1px solid #eaeaea; border-bottom-left-radius: 2px;' %>">
        <p style="margin: 0; color: #333;"><%= msg.content %></p>
        <span style="font-size: 0.7em; color: #999; display: block; text-align: right; margin-top: 5px;"><%= msg.created_at.strftime("%H:%M") %></span>
      </div>
    <% end %>
  </div>

  <div style="padding: 15px; background-color: #eee; border-top: 1px solid #ddd;">
    <%= form_with model: [@conversation, @new_message], local: true, style: "display: flex; gap: 10px;" do |f| %>
      <%= f.text_field :content, placeholder: "Escribe un mensaje...", style: "flex: 1; padding: 10px; border-radius: 20px; border: 1px solid #ccc; outline: none;", required: true, autocomplete: "off" %>
      <%= f.submit "Enviar 🚀", style: "background-color: #2e83ff; color: white; border: none; padding: 10px 20px; border-radius: 20px; cursor: pointer; font-weight: bold;" %>
    <% end %>
  </div>

</div>